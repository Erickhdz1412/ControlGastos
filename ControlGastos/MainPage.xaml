<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ControlGastos.MainPage"
             Title="Gastos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Entry x:Name="DescripcionEntry" Placeholder="Descripción del gasto" />
            <Entry x:Name="MontoEntry" Placeholder="Monto" Keyboard="Numeric" />
            <Picker x:Name="CategoriaPicker" Title="Categoría" />
            <DatePicker x:Name="FechaPicker" DateSelected="OnFechaSelected" />

            <Button Text="Agregar gasto" Clicked="OnAddClicked" />

            <SearchBar x:Name="BuscarBar" Placeholder="Buscar gasto..." TextChanged="OnBuscarTextChanged" />

            <Label x:Name="TotalLabel" FontSize="20" FontAttributes="Bold" Text="Total: $0.00" />

            <ListView x:Name="GastosListView" ItemSelected="OnGastoSelected">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout Orientation="Horizontal" Spacing="10">
                                <Label Text="{Binding Descripcion}" FontSize="18" />
                                <Label Text="{Binding Categoria, StringFormat=' ({0})'}" />
                                <Label Text="{Binding Monto, StringFormat=' ${0:F2}'}" />
                                <Label Text="{Binding Fecha, StringFormat=' {0:dd/MM/yyyy}'}" />
                                <Button Text="Eliminar" Clicked="OnDeleteClicked" CommandParameter="{Binding .}" />
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
